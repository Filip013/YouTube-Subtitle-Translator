{
  "manifest_version": 3,
  "name": "YouTube Subtitle Translator (Gemini Live)",
  "version": "1.2.0",
  "description": "Real-time AI audio subtitle translator to Serbian using Gemini 3.1 Flash Live via WebSockets.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "wss://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/audio_utils.js",
        "src/vad_processor.js",
        "src/storage_manager.js",
        "src/gemini_live_client.js",
        "src/gemini_service.js",
        "src/subtitle_renderer.js",
        "src/audio_capture.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Gemini Live Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
